<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <style>
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 80px;
            background: linear-gradient(rgba(11, 18, 32, 0.8), rgba(11, 18, 32, 0.9)), url('https://images.unsplash.com/photo-1512917774080-9991f1c4c750?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover;
        }
        .auth-card {
            width: 100%;
            max-width: 450px;
            padding: 3rem;
        }
        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        .auth-header i {
            font-size: 3rem;
            color: var(--primary-color);
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="auth-container">
        <div class="glass-panel auth-card">
            <div class="auth-header">
                <i class="fa-solid fa-user-circle"></i>
                <h2>Welcome Back</h2>
                <p>Login to your premium account</p>
            </div>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST">
                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="email" class="form-control" required placeholder="Enter your email">
                </div>
                
                <div class="form-group">
                    <div class="d-flex justify-content-between">
                        <label class="form-label">Password</label>
                        <a href="#" style="font-size: 0.875rem;">Forgot Password?</a>
                    </div>
                    <input type="password" name="password" class="form-control" required placeholder="Enter your password">
                </div>

                <div class="form-group d-flex align-items-center gap-1" style="margin-bottom: 2rem;">
                    <input type="checkbox" id="remember">
                    <label for="remember" style="color: var(--text-secondary); cursor:pointer;">Remember Me</label>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%;">Login</button>
            </form>
            
            <div class="text-center mt-2">
                <p>Don't have an account? <a href="/register">Sign Up</a></p>
            </div>
        </div>
    </div>

</body>
</html>
