<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <style>
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 100px;
            padding-bottom: 40px;
            background: linear-gradient(rgba(11, 18, 32, 0.8), rgba(11, 18, 32, 0.9)), url('https://images.unsplash.com/photo-1600607687959-ce8a6c25118c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover;
        }
        .auth-card {
            width: 100%;
            max-width: 500px;
            padding: 3rem;
        }
        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        .auth-header i {
            font-size: 3rem;
            color: var(--primary-color);
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="auth-container">
        <div class="glass-panel auth-card">
            <div class="auth-header">
                <i class="fa-solid fa-user-plus"></i>
                <h2>Create Account</h2>
                <p>Join the most premium real estate platform</p>
            </div>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
                </div>
            <% } %>

            <form action="/register" method="POST">
                <div class="form-group">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="fullName" class="form-control" required placeholder="John Doe">
                </div>
                
                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="email" class="form-control" required placeholder="john@example.com">
                </div>

                <div class="form-group">
                    <label class="form-label">Phone Number</label>
                    <input type="text" name="phone" class="form-control" required placeholder="+1 234 567 890">
                </div>
                
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" required placeholder="Create a strong password">
                </div>

                <div class="form-group" style="margin-bottom: 2rem;">
                    <label class="form-label">Confirm Password</label>
                    <input type="password" name="confirmPassword" class="form-control" required placeholder="Confirm your password">
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%;">Create Account</button>
            </form>
            
            <div class="text-center mt-2">
                <p>Already have an account? <a href="/login">Login</a></p>
            </div>
        </div>
    </div>

</body>
</html>
